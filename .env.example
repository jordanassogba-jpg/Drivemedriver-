# Connexion WordPress - VTC Strasbourg DMD
# Copier ce fichier en .env puis remplir les valeurs.
# .env est ignore par git : le mot de passe ne part jamais sur le depot.

WP_SITE_URL="https://vtc-strasbourg-dmd.fr"
