# Mot de passe d'application WordPress (Utilisateurs > Profil > Mots de passe d'application)
# Les espaces sont acceptes, le script les retire automatiquement.
WP_APP_PASSWORD="xxxx xxxx xxxx xxxx xxxx xxxx"
