# Configuration de connexion à l'API REST WordPress
# Copier ce fichier en .env puis renseigner les valeurs réelles.
# .env est ignoré par git : les identifiants ne doivent jamais être commités.

# URL racine du site, sans slash final
WP_SITE_URL="https://exemple.fr"

# Compte WordPress propriétaire du mot de passe d'application
WP_USER="contact@exemple.fr"

# Mot de passe d'application généré dans WordPress
# (Utilisateurs > Profil > Mots de passe d'application)
# Les espaces sont acceptés, le script les retire automatiquement.
WP_APP_PASSWORD="xxxx xxxx xxxx xxxx xxxx xxxx"

# Optionnel : délai maximum par requête, en secondes
WP_TIMEOUT="30"
